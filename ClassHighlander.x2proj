      <SubType>Content</SubType>
    </Content>
    <Content Include="Src\ClassHighlander\Classes\UIScreenListener_TrainingCenter_CH.uc">
      <SubType>Content</SubType>
    </Content>
    <Content Include="Src\ClassHighlander\Classes\UIScreenListener_ChooseClass_CH.uc">
      <SubType>Content</SubType>
