    <Content Include="Config\XComEngine.ini" />
    <Content Include="Config\XComGame.ini" />
    <Content Include="Localization\ClassHighlander.int" />
    <Content Include="Localization\ClassHighlander.fra" />
    <Content Include="Localization\XComGame.int" />
	<Content Include="Localization\XComGame.fra" />
