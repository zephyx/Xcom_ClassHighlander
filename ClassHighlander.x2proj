  <PropertyGroup>
    <Guid>bdd413c5-7f4a-48ad-8f36-19ebd3253e59</Guid>
    <Name>ClassHighlander</Name>
    <Description>Restrict all soldier and MEC classes to only 1 by campaign, each promotion/GTS/MEC Trooper Training/Black Market/Mission reward will be a unique class not already owned.</Description>
    <SteamPublishID>0</SteamPublishID>
    <AssemblyName>ClassHighlander</AssemblyName>
    <RootNamespace>ClassHighlander</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Folder Include="Config\" />
